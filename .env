# ==========================================
# ФАЙЛ КОНФИГУРАЦИИ Я.Д-Пылесос (.env)
# Единый источник истины (SSOT) для Bash и Python
# ==========================================

# --- СИСТЕМНЫЕ НАСТРОЙКИ ---
# Часовой пояс контейнера (влияет на время в логах и работу cron)
TZ=Europe/Moscow

# --- ЛИМИТЫ И ПРОИЗВОДИТЕЛЬНОСТЬ ---
# Максимальное время работы контейнера в секундах (21600 = 6 часов). 
# Если скачивание длится дольше, оно будет принудительно остановлено.
MAX_RUNTIME=21600

# Максимальный размер одного файла лога Docker (до его сжатия/ротации)
LOG_MAX_SIZE=10m

# Количество хранимых файлов логов Docker (старые будут удаляться)
LOG_MAX_FILES=5

# Максимальное количество попыток API-запроса/скачивания подряд.
# ВНИМАНИЕ: это же число - порог срабатывания VPN-failover/ротации при банах.
MAX_RETRIES=5

# Размер чанка скачивания в МБ (память одного запроса; размер кусков записи на диск)
CHUNK_SIZE_MB=10

# Лимит записей очереди в БД. После ADR-0001 (SQLite) RAM не защищает -
# это пауза Фазы 2 при переполнении очереди.
QUEUE_LIMIT=10000

# Минимальный размер файла в Мегабайтах, при котором включается 
# многопоточное скачивание (если включено больше 1 потока).
MULTITHREAD_SIZE_MB=100

# --- ИНФРАСТРУКТУРА ---
# Имя собранного Docker-образа Пылесоса (используется для запуска)
DOCKER_IMG=yadpylesos-slim

# Список DNS серверов через пробел (пробрасываются в контейнер)
DNS_SERVERS="8.8.8.8 1.1.1.1"

# Путь к файлу температуры CPU на хосте (для проброса в контейнер через volume)
THERMAL_CPU_PATH="/sys/devices/virtual/thermal/thermal_zone0/temp"

# --- НАСТРОЙКИ VPN (Xray-core) ---
# Локальный порт SOCKS5 для проксирования
PROXY_PORT=10808

# --- НАСТРОЙКИ ИНТЕРФЕЙСА И МОНИТОРИНГА ---
# Профиль браузера для HTTP-заголовков
BROWSER_CHOICE=1
# 1 - Chrome
# 2 - Firefox
# 3 - Safari

# Срок жизни кэша дерева Яндекса в днях (после этого кэш считается устаревшим)
CACHE_TTL_DAYS=7

# Интервал вывода панели состояния (--trace-status) в секундах
TRACE_INTERVAL=60

# Сколько строк лога показывать при подключении к контейнеру (docker logs --tail)
TAIL_LINES=50

# --- ГОМЕОСТАЗ 2.0 (Мониторинг температуры) ---
# Температура CPU (в градусах Цельсия), при которой скрипт снижает потоки и скорость записи
TEMP_CPU_HIGH=75
# Температура CPU, при которой скрипт возвращается к нормальной скорости
TEMP_CPU_LOW=60

# --- ТЕЛЕМЕТРИЯ И ОБСЛУЖИВАНИЕ БД ---
# Срок хранения исторической телеметрии (в днях)
TELEMETRY_RETENTION_DAYS=30
# Сколько последних записей из телеметрии выводить при --db-stats
DB_STATS_LIMIT=10

# Срок хранения логов в папке report/ (в днях)
LOG_RETENTION_DAYS=14

# --- ВРЕМЕННЫЕ ИНТЕРВАЛЫ (в секундах) ---
# Как часто выводить промежуточный статус скачивания файла в лог
STATUS_LOG_INTERVAL=300
# Как часто сбрасывать кэш дерева Яндекса на диск
CACHE_SAVE_INTERVAL=300
# Как часто формировать файл со списком недокачанных файлов
FAILED_REPORT_INTERVAL=1800
# Как часто Bash проверяет статус контейнера в фоновом режиме
CONTAINER_POLL_INTERVAL=10

# --- ПОРОГИ ГОМЕОСТАЗА (Железо) ---
# Порог задержки записи на диск (I/O Latency) в мс для снижения потоков
IO_LATENCY_THRESHOLD_MS=2000
# Порог нагрузки CPU (Load Average) для снижения потоков
LOAD_HIGH=4.0
# Порог нагрузки CPU (Load Average) для восстановления потоков
LOAD_LOW=2.0

# --- НАСТРОЙКИ ВИДЕО-ДВИЖКА (OmniReaper) ---
# Как часто обновлять yt-dlp (в днях). 0 = обновлять при каждом запуске.
VIDEO_ENGINE_UPDATE_DAYS=1

# Таймаут бездействия видео-движка (в секундах). Если yt-dlp ничего не выводит 5 минут, процесс убивается.
VIDEO_DOWNLOAD_TIMEOUT=300

# Кэш yt-dlp внутри контейнера (EJS-решатель, sigfuncs): чистится вместе с контейнером
XDG_CACHE_HOME=/cache-yt

# --- ПРОАКТИВНЫЙ АНТИБАН (YouTube) ---
# Сколько событий 429 подряд (без успешных извлечений между) = серия
ANTIBAN_429_SERIES=5
# Пауза в секундах при достижении серии
ANTIBAN_PAUSE_SEC=60
