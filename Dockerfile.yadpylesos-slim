# ==========================================
# Проект: Я.Д-Пылесос / YA.D-Pylesos
# Образ: Slim (Оптимизированный)
# Версия: 12.0
# ==========================================

# Базовый образ: легкий Debian с Python 3.12
FROM python:3.12-slim

# Отключаем буферизацию вывода. 
# Это критически важно, чтобы логи Python сразу падали в docker logs без задержек.
ENV PYTHONUNBUFFERED=1

# Задаем рабочую директорию внутри контейнера
WORKDIR /app

# BL-Infra: Использование ARG для версий (DRY)
ARG MIHOMO_VERSION=v1.18.5

# Устанавливаем системные утилиты: tzdata (часовые пояса) и ca-certificates (SSL)
# Также добавляем wget и gzip для скачивания mihomo
RUN apt-get update && apt-get install -y --no-install-recommends \
    tzdata \
    ca-certificates \
    curl \
    procps \
    sqlite3 \
    locales \
    wget \
    gzip \
    && rm -rf /var/lib/apt/lists/*

# Генерируем русскую локаль для безупречной работы с кириллицей в путях и логах
RUN sed -i '/ru_RU.UTF-8/s/^# //g' /etc/locale.gen && locale-gen
ENV LANG=ru_RU.UTF-8
ENV LANGUAGE=ru_RU:ru
ENV LC_ALL=ru_RU.UTF-8

# Часовой пояс
ENV TZ=Europe/Moscow

# BL-Infra: Безопасность (Non-root user по умолчанию внутри контейнера)
RUN groupadd -r appgroup && useradd -r -g appgroup appuser

# BL-Infra: Использование requirements.txt (Pin versions)
COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

# Установка mihomo (Clash.Meta) для модуля VPN
# Скачиваем бинарник
RUN ARCH=$(dpkg --print-architecture) && \
    wget -qO /tmp/mihomo.gz "https://github.com/MetaCubeX/mihomo/releases/download/${MIHOMO_VERSION}/mihomo-linux-${ARCH}-${MIHOMO_VERSION}.gz" && \
    gunzip /tmp/mihomo.gz && \
    mv /tmp/mihomo /usr/local/bin/mihomo && \
    chmod +x /usr/local/bin/mihomo

# BL-Fix: Скачиваем базы GeoIP/GeoSite в системную папку
RUN mkdir -p /etc/mihomo && \
    wget -qO /etc/mihomo/geoip.metadb "https://github.com/MetaCubeX/meta-rules-dat/releases/download/latest/geoip.metadb" && \
    wget -qO /etc/mihomo/geosite.dat "https://github.com/MetaCubeX/meta-rules-dat/releases/download/latest/geosite.dat" && \
    wget -qO /etc/mihomo/geoip.dat "https://github.com/MetaCubeX/meta-rules-dat/releases/download/latest/geoip.dat"

# Базовая команда
CMD ["sleep", "infinity"]

# BL-Infra: Умный HEALTHCHECK. Проверяет, жив ли процесс Python, а не просто открыт ли порт.
HEALTHCHECK --interval=1m --timeout=10s --retries=3 CMD pgrep -f "yadpylesos.py" || exit 1
