# Базовый образ: легкий Debian с Python 3.12
FROM python:3.12-slim

# Отключаем буферизацию вывода. 
# Это критически важно, чтобы логи Python сразу падали в docker logs без задержек.
ENV PYTHONUNBUFFERED=1

# Задаем рабочую директорию внутри контейнера
WORKDIR /app

# Устанавливаем системные утилиты: tzdata (часовые пояса) и ca-certificates (SSL)
# Также добаваем wget и gzip для скачивания mihomo
# Зеркало Яндекса: deb.debian.org (Fastly) недоступен из сети NAS
RUN sed -i 's|deb.debian.org|mirror.yandex.ru|g' /etc/apt/sources.list.d/debian.sources \
    && apt-get update && apt-get install -y --no-install-recommends \
    tzdata \
    ca-certificates \
    curl \
    procps \
    sqlite3 \
    locales \
    wget \
    gzip \
    unzip \
    ffmpeg \
    gnupg \
    && rm -rf /var/lib/apt/lists/*

# Node.js 24 LTS (NodeSource): node 20 из репозитория Debian не поддерживается EJS в yt-dlp
RUN mkdir -p /etc/apt/keyrings \
    && curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg \
    && echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_24.x nodistro main" > /etc/apt/sources.list.d/nodesource.list \
    && apt-get update && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

