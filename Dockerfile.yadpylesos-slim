# Xray-core поставляется в build_assets/ (скачивается вне сборки:
# Fastly-CDN GitHub недоступен из сети NAS). Текущий бинарник: v26.7.28, arm64-v8a

#скачать пакет, положить в build_assets/
#wget https://github.com/XTLS/Xray-core/releases/download/v26.7.28/Xray-linux-arm64-v8a.zip
COPY build_assets/Xray-linux-arm64-v8a.zip /tmp/xray.zip
# bgutil PO-провайдер: исходники + скомпилированный build/ + node_modules (собрано на D4 через npmmirror)
COPY build_assets/bgutil-server/server /opt/bgutil
RUN unzip -o /tmp/xray.zip -d /tmp/xray && \
    mv /tmp/xray/xray /usr/local/bin/xray && \
    chmod +x /usr/local/bin/xray && \
    mkdir -p /etc/xray && \
    mv /tmp/xray/geoip.dat /etc/xray/ && \
    mv /tmp/xray/geosite.dat /etc/xray/ && \
    rm -rf /tmp/xray*

# Генерируем русскую локаль для безупречной работы с кириллицей в путях и логах
RUN sed -i '/ru_RU.UTF-8/s/^# //g' /etc/locale.gen && locale-gen
ENV LANG=ru_RU.UTF-8
ENV LANGUAGE=ru_RU:ru
ENV LC_ALL=ru_RU.UTF-8

# Часовой пояс
ENV TZ=Europe/Moscow

# BL-Infra: Безопасность (Non-root user по умолчанию внутри контейнера)
RUN groupadd -r appgroup && useradd -r -g appgroup appuser

# BL-Infra: Использование requirements.txt (Pin versions)
COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

# Базовая команда
CMD ["sleep", "infinity"]

# BL-Infra: Умный HEALTHCHECK. Проверяет, жив ли процесс Python, а не просто открыт ли порт.
HEALTHCHECK --interval=1m --timeout=10s --retries=3 CMD pgrep -f "yadpylesos.py" || exit 1
